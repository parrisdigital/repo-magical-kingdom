{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/parrisdigital/repo-magical-kingdom/blob/main/attribution/registry.schema.json",
  "title": "Repo Magical Kingdom attribution registry",
  "type": "object",
  "required": ["schemaVersion", "project", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["name", "repository", "license"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "relationship",
        "canonicalUrl",
        "distribution",
        "license",
        "authors",
        "usage",
        "projectLocations",
        "redistributedFiles"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "project-predecessor",
            "research-reference",
            "external-service",
            "runtime-dependency",
            "adapted-source",
            "asset",
            "generated-media"
          ]
        },
        "relationship": { "type": "string", "minLength": 1 },
        "canonicalUrl": { "type": "string", "format": "uri" },
        "distribution": {
          "enum": [
            "not-distributed",
            "external-response",
            "bundled-runtime",
            "package-install-only",
            "research-citation",
            "standalone-files"
          ]
        },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "packageName": { "type": "string", "minLength": 1 },
        "license": {
          "type": "object",
          "required": ["spdx", "status", "url"],
          "additionalProperties": false,
          "properties": {
            "spdx": { "type": ["string", "null"] },
            "status": {
              "enum": ["declared", "not-declared", "generated-review-required"]
            },
            "url": { "type": ["string", "null"], "format": "uri" }
          }
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "usage": { "type": "string", "minLength": 1 },
        "projectLocations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "redistributedFiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "contentHashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "modifications": { "type": "string" },
        "notes": { "type": "string" },
        "generatedMediaProvenance": {
          "$ref": "#/$defs/generatedMediaProvenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "generated-media" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["contentHashes", "generatedMediaProvenance"],
            "properties": {
              "redistributedFiles": { "minItems": 1 },
              "contentHashes": { "minProperties": 1 }
            }
          }
        }
      ]
    },
    "generatedMediaProvenance": {
      "type": "object",
      "required": [
        "generator",
        "generatedAt",
        "prompt",
        "negativeConstraints",
        "referenceAssets",
        "humanEdits",
        "conversionSteps",
        "sourceContentHashes",
        "attributionText",
        "review"
      ],
      "additionalProperties": false,
      "properties": {
        "generator": {
          "type": "object",
          "required": ["tool", "model", "version"],
          "additionalProperties": false,
          "properties": {
            "tool": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "canonicalUrl": { "type": "string", "format": "uri" }
          }
        },
        "generatedAt": { "type": "string", "format": "date-time" },
        "prompt": { "type": "string", "minLength": 1 },
        "negativeConstraints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "referenceAssets": {
          "type": "array",
          "items": { "$ref": "#/$defs/referenceAsset" }
        },
        "humanEdits": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "conversionSteps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceContentHashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "attributionText": { "type": "string", "minLength": 1 },
        "review": {
          "type": "object",
          "required": [
            "reviewer",
            "reviewedAt",
            "confirmsNoProtectedProjectImitation",
            "confirmsNoThirdPartyLogosOrCharacters"
          ],
          "additionalProperties": false,
          "properties": {
            "reviewer": { "type": "string", "minLength": 1 },
            "reviewedAt": { "type": "string", "format": "date-time" },
            "confirmsNoProtectedProjectImitation": { "const": true },
            "confirmsNoThirdPartyLogosOrCharacters": { "const": true },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "referenceAsset": {
      "type": "object",
      "required": ["description", "rights"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "canonicalUrl": { "type": ["string", "null"], "format": "uri" },
        "localFile": { "type": "string", "minLength": 1 },
        "rights": { "type": "string", "minLength": 1 }
      }
    }
  }
}
