  "authoredMaterialIntegration": {
    "exactMaterialNames": {
      "MI_Plaster": "plaster",
      "MI_UnevenBrick": "brick",
      "MI_WoodTrim": "wood",
      "MI_RoundTiles": "roof-tile"
    },
    "requiredUvSet": "TEXCOORD_0",
    "requiredAuthoredMaps": ["baseColorTexture", "normalTexture", "metallicRoughnessTexture"],
    "baseColorPolicy": "Preserve the authored base color and baseColorTexture. The atlas albedo is audited reference data and is not sampled by the additive detail shader.",
    "detailPolicy": "Layer only repeat-scaled OpenGL tangent-space normal and mean-centered roughness detail.",
    "conservativeDefaultTuning": {
      "plaster": { "repeat": [3, 3], "normalStrength": 0.2, "roughnessStrength": 0.08 },
      "brick": { "repeat": [1, 1], "normalStrength": 0.1, "roughnessStrength": 0.05 },
      "wood": { "repeat": [3, 3], "normalStrength": 0.16, "roughnessStrength": 0.08 },
      "roof-tile": { "repeat": [1, 1], "normalStrength": 0.09, "roughnessStrength": 0.05 }
    },
    "windowEmissive": {
      "exactMaterialName": "MI_WindowGlass",
