      "addedDrawCalls": 0,
      "addedSamplers": 0,
      "addedFragmentTextureReads": 0
    },
    "visualTuningRequired": true
  },
  "conversion": {
    "tool": "sharp",
    "toolVersion": "0.35.3",
    "steps": [
      "Verify each official Poly Haven 1K JPEG against the API MD5 and recorded SHA-256.",
      "Resize each 1024 x 1024 tile to 896 x 896 with Lanczos3 filtering.",
      "Extend each tile by 64 pixels on all sides using copied edge pixels.",
      "Pack roles left-to-right as plaster, brick, wood, and roof-tile in a 4096 x 1024 high atlas.",
      "Repeat the transform with 448-pixel tiles and 32-pixel gutters for a 2048 x 512 low atlas.",
      "Keep gutters at least one-half texel wide through mip 7 for high and mip 6 for low.",
      "Convert roughness to explicit grayscale before opaque RGB atlas compositing.",
      "Encode albedo as quality-84 WebP, OpenGL normals as quality-90 WebP, and roughness as quality-88 WebP."
    ],
    "sourceFilesDistributed": false
  }
}
