  "conversion": {
    "tool": "sharp",
    "toolVersion": "0.35.3",
    "steps": [
      "Verify each official 1K JPEG source against the Poly Haven API MD5 and recorded SHA-256.",
      "Resize each 1024 x 1024 tile to 896 x 896 with Lanczos3 filtering.",
      "Extend each tile by 64 pixels on all sides using copied edge pixels.",
      "Pack roles left-to-right as grass, soil, rock, and shore in a 4096 x 1024 atlas.",
      "Repeat the transform with 448-pixel tiles and 32-pixel gutters for a 2048 x 512 low-memory tier.",
      "Use proportional power-of-two gutters that remain at least one-half texel wide through mip level 7 on desktop and mip level 6 on low-memory atlases.",
      "Convert roughness to explicit grayscale before RGB atlas compositing.",
      "Encode albedo as quality-84 WebP, OpenGL normals as quality-88 WebP, and roughness as quality-86 WebP."
    ],
    "sourceFilesDistributed": false
  }
