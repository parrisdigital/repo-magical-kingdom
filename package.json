{
  "name": "repo-magical-kingdom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn public GitHub repositories into living, selectable 3D worlds and planetary universes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/parrisdigital/repo-magical-kingdom.git"
  },
  "homepage": "https://repo-magical-kingdom.vercel.app",
  "bugs": {
    "url": "https://github.com/parrisdigital/repo-magical-kingdom/issues"
  },
  "keywords": [
    "3d",
    "github",
    "nextjs",
    "open-source",
    "procedural-generation",
    "react-three-fiber",
    "repository-visualization",
    "threejs"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "assets:build": "node scripts/assets/build-world-assets.mjs",
    "assets:verify": "pnpm assets:quaternius:verify && pnpm assets:seasonal:verify && pnpm assets:terrain:verify && pnpm assets:environment:verify && pnpm assets:architecture:verify && pnpm assets:v2:verify",
    "assets:architecture:build": "node scripts/assets/build-architecture-detail-assets.mjs",
    "assets:architecture:verify": "node scripts/assets/verify-architecture-detail-assets.mjs",
    "assets:environment:build": "node scripts/assets/build-environment-hdri-assets.mjs",
    "assets:environment:verify": "node scripts/assets/verify-environment-hdri-assets.mjs",
    "assets:quaternius:build": "node scripts/assets/build-quaternius-assets.mjs",
    "assets:quaternius:verify": "node scripts/assets/verify-quaternius-assets.mjs",
    "assets:seasonal:build": "node scripts/assets/build-kenney-seasonal-assets.mjs",
    "assets:seasonal:verify": "node scripts/assets/verify-kenney-seasonal-assets.mjs",
    "assets:terrain:build": "node scripts/assets/build-terrain-pbr-assets.mjs",
    "assets:terrain:verify": "node scripts/assets/verify-terrain-pbr-assets.mjs",
    "assets:v2:build": "node scripts/assets-v2/build-original-textures.mjs && node scripts/assets-v2/build-original-assets.mjs",
    "assets:v2:verify": "node scripts/assets-v2/verify-original-assets.mjs",
    "assets:v2:verify:release": "node scripts/assets-v2/verify-original-assets.mjs --require-tools",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "visual:gauntlet": "node scripts/visual/run-gauntlet.mjs",
    "visual:gauntlet:smoke": "node scripts/visual/run-gauntlet.mjs --smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm assets:v2:verify && pnpm test && pnpm build"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.4.2",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
